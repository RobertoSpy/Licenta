generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  password     String
  name         String?
  refreshToken String?   // SalveazÄƒ tokenul de refresh curent pentru securitate (opÈ›ional, dar recomandat pt validare la delogare)
  passwordResetToken   String?
  passwordResetExpires DateTime?
  projects     Project[]
  createdAt    DateTime  @default(now())
}

model Project {
  id     Int    @id @default(autoincrement())
  title  String
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // === SCREEN 1: Identificare Teren ===
  lat               Float?
  lng               Float?
  // polygonGeoJSON stocheazÄƒ Json â€” suprafaÈ›a se calculeazÄƒ Ã®n backend cu turf.js
  // È™i se salveazÄƒ Ã®n plotAreaSqm. Nu se recalculeazÄƒ la citire.
  polygonGeoJSON    Json?
  county            String?
  locality          String?
  seismicZone       String?   // "0.10g" | "0.15g" | "0.20g" | "0.25g" | "0.30g" | "0.35g"
  frostDepthCm      Int?
  plotAreaSqm       Float?    // calculat cu turf.js la salvare, stocat aici

  // === SCREEN 2: Caracteristici Teren ===
  soilType          String?   // "Argilos" | "Nisipos" | "Pietros" | "StÃ¢ncos" | "Necunoscut"
  slopePercent      Float?
  streetOrientation String?   // "N" | "NE" | "E" | "SE" | "S" | "SV" | "V" | "NV"
  soilNotes         String?

  // === SCREEN 3: ReglementÄƒri (generate de AI, salvate pentru referinÈ›Äƒ) ===
  maxAllowedFloors     Int?
  minFoundationDepthCm Int?
  zoningRestrictions   String?

  // === SCREEN 4: Tipul Casei ===
  houseStyle       String?   // "Modern" | "Industrial" | "Clasic" | "Mediteranean"
  buildingPurpose  String    @default("residential") // "residential" | "commercial" | "mixed"
  hasBasement      Boolean   @default(false)
  hasGroundFloor   Boolean   @default(true)
  upperFloorsCount Int       @default(0)
  hasMansard       Boolean   @default(false)
  totalFloors      Int?      // calculat: basement(0/1) + parter(1) + etaje + mansardÄƒ(0/1)

  // Starea Wizard-ului â€” DB este sursa de adevÄƒr
  wizardStep   Int     @default(1)
  isCompleted  Boolean @default(false)

  bomItems      ProjectBOM[]
  chatSummaries ChatSummary[]
  planSnapshots PlanSnapshot[]

  // Faza 2 — plan 2D
  publishedSnapshotId Int?     // FK la snapshotul publicat (versiunea oficială)
  totalFloorAreaSqm   Float?   // calculat la publish din plan
  planStatus          String?  // "draft" | "published" | "approved"

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

// 3. Catalogul de Materiale 
model Material {
  id          Int      @id @default(autoincrement())
  name        String   
  category    String   
  unit        String   
  price       Float    
  storeUrl    String?  
  
  bomItems    ProjectBOM[] 
}

// 4. Devizul 
model ProjectBOM {
  id          Int      @id @default(autoincrement())
  
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  materialId  Int
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  
  quantity    Float    
  totalPrice  Float   
}

// === PENTRU RAG ===
model NormativeChunk {
  id        Int    @id @default(autoincrement())
  source    String // "NP112-2014" | "P100-2013" | "CR6-2013" etc.
  chapter   String // "Cap.3 - Identificarea vizuala a solului"
  content   String // 800-1000 cuvinte per chunk
  agent     String @default("general")  // "geotehnic" | "seismic" | "legal" | "structural" | "materiale" | "deviz"
  status    String @default("in_vigoare") // "in_vigoare" | "in_revizuire" | "abrogat"
  embedding Unsupported("vector(3072)")?

  @@index([source])
  @@index([agent])
  @@index([status])
}

// === ISTORICUL CHAT-ULUI (Rezumate persistente per proiect/faza/ecran) ===
model ChatSummary {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  phase     String   // "faza1" | "faza2" | "faza3"
  screen    String?  // "screen1" | "screen2" | "screen3" | "screen4" | "editor" | "bom" | null = rezumat global
  summary   String   // Textul rezumatului acumulat (max ~500 cuvinte)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un singur rezumat activ per (proiect, faza, ecran)
  @@unique([projectId, phase, screen])
  @@index([projectId])
}

// === FAZA 2: Snapshoturi plan 2D ===
model PlanSnapshot {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  planJSON    Json     // Starea completă Konva: { elements: [...], scale, viewport }
  floor       String   @default("parter") // "parter" | "etaj1" | "etaj2" | "mansarda"
  version     Int      @default(1)  // auto-increment per proiect
  label       String?  // \"Versiune manual\u0103\"
  isPublished Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([projectId])
}
